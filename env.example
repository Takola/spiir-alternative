# Copy to .env and replace placeholders. The backend loads .env automatically.

SPIIR_ALT_DATA_DIR=data
ENABLEBANKING_APP_ID=your-enable-banking-app-id
ENABLEBANKING_PRIVATE_KEY_PATH=data/local_secrets/enablebanking/your-enable-banking-app-id.pem
ENABLEBANKING_REDIRECT_URL=https://your-domain.example/enablebanking/callback
ENABLEBANKING_PSU_ID=spiir-alternative-local
SPIIR_CUTOVER_DATE=2026-01-01

# Optional. Keep the default loopback binding unless LAN access is intentional.
SPIIR_FRONTEND_HOST=127.0.0.1
